{
  // The Bot You Own — Cloudflare Worker config.
  // You do NOT need to understand this file. The deploy button reads it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot-you-own",
  "main": "engine/index.js",
  "compatibility_date": "2026-08-01",

  // Workers AI — this is what actually answers. No API key. It's included.
  "ai": { "binding": "AI" },

  // The chat page and the embed script live in /public.
  // run_worker_first: static assets are normally served BEFORE the Worker runs.
  // These paths must go through the Worker so the admin gate applies to /engine/*.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/engine/*", "/api/*"] },

  // Lets the code read projects/**/*.md as plain text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // Rate limit per visitor: 30 messages a minute. Generous for a human, useless
  // for a script. ON by default — it's the first line of the firewall (LLM10).
  // period must be 10 or 60.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  // The audit log (D1). The Worker creates its own table on first use, so there is
  // no schema step. The Deploy button provisions a fresh database in the attendee's
  // account; Jim's terminal deploy uses this one. Remove the block to log nowhere
  // but Workers Logs. Read it under the hood → Audit, or with the queries in CUSTOMIZE.md.
  "d1_databases": [
    { "binding": "DB", "database_name": "bot-you-own-logs", "database_id": "cc9d43d1-46fa-4c1e-8501-a0565bdd7b77" }
  ],

  // Copies the engine source into public/engine/ for the admin "Under the hood"
  // view. Runs before dev and deploy. The Worker gates /engine/* behind the admin code.
  "build": { "command": "node scripts/snapshot-src.mjs" },

  "observability": { "enabled": true }
}
